# Copy this file to .env and fill in real values. .env is gitignored; this file
# documents what's required so anyone (including a hosting platform) knows what
# to configure.

# Postgres connection strings. Easiest path: in your Vercel project, go to
# Storage -> Create Database -> Postgres (powered by Neon), which fills these
# in for you automatically. Or create a database directly at https://neon.tech.
#   DATABASE_URL - the pooled connection, used by the app at runtime. Must
#                  include "&pgbouncer=true" or every query fails against
#                  Neon's pooler even though it's reachable.
#   DIRECT_URL   - the direct (unpooled) connection, used only for migrations
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Vercel Blob token for document uploads. In your Vercel project: Storage ->
# Create Database -> Blob. It's injected automatically for deployed code; for
# local development run `vercel env pull .env.local` after connecting the
# project, or copy the token from the dashboard.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Random secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Use a different value per environment and never commit the real value.
SESSION_SECRET=""
